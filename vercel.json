{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/project-next-project.html",
      "destination": "/#hub",
      "permanent": true
    },
    {
      "source": "/project-next-project",
      "destination": "/#hub",
      "permanent": true
    },
    {
      "source": "/project-flare-alert.html",
      "destination": "/#hub",
      "permanent": true
    },
    {
      "source": "/project-flare-alert",
      "destination": "/#hub",
      "permanent": true
    },
    {
      "source": "/project-ecofertile.html",
      "destination": "/#hub",
      "permanent": true
    },
    {
      "source": "/project-ecofertile",
      "destination": "/#hub",
      "permanent": true
    },
    {
      "source": "/resume.html",
      "destination": "/legacy/resume.html",
      "permanent": false
    },
    {
      "source": "/resume",
      "destination": "/legacy/resume.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|legacy/|static/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(assets|static)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
